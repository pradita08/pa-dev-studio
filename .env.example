# Konfigurasi API autentikasi PA DEV STUDIO.
# Salin menjadi `.env` di folder ini sebelum `docker compose up`.
#
#   cp .env.example .env
#   openssl rand -hex 32     # tempel hasilnya ke JWT_SECRET

# Rahasia penanda tangan JWT. Minimal 32 karakter dan WAJIB diganti.
# Mengganti nilai ini membuat seluruh sesi yang sedang berjalan tidak berlaku.
JWT_SECRET=ganti-dengan-hasil-openssl-rand-hex-32

# Umur token. Access pendek karena dibawa setiap request; refresh panjang
# karena tersimpan sebagai cookie httpOnly dan bisa dicabut dari database.
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

# Set `true` hanya kalau situs sudah dilayani lewat HTTPS. Pada HTTP lokal,
# cookie Secure tidak akan pernah dikirim browser dan login akan gagal.
COOKIE_SECURE=false

# Admin pertama, dibuat sekali saat tabel `users` masih kosong. Setelah akun
# ada, mengubah nilai di sini tidak mengubah password akun tersebut.
ADMIN_EMAIL=admin@padev.local
ADMIN_PASSWORD=ganti-password-admin-ini
ADMIN_NAME=Pradita Alfiantoni

# Pembatas percobaan login per IP + email.
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_SECONDS=900
